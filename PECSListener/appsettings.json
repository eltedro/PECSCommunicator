{
  // PECS Listener alert options (TODO #9). Missing values use the defaults shown here.

  // Speak each press aloud using the Windows voice. {tile} is replaced with the tile name.
  "Speak": true,
  "SpeechTemplate": "Ian wants {tile}",

  // Flash the taskbar button until someone clicks the Listener window.
  "FlashTaskbar": true,

  // Pop the window to the front on each press. Windows may only flash it instead (focus rules).
  "BringToFront": false,

  // Sound played before the speech, per tile. "Default" is for tiles not listed.
  // A missing file falls back to the Windows "Asterisk" sound.
  "Sounds": {
    "Toilet":  "C:\\Windows\\Media\\chimes.wav",
    "Eat":     "C:\\Windows\\Media\\Windows Notify Messaging.wav",
    "Walk":    "C:\\Windows\\Media\\tada.wav",
    "Help":    "C:\\Windows\\Media\\Windows Exclamation.wav",
    "Default": "C:\\Windows\\Media\\Windows Notify System Generic.wav"
  }
}
