{
  // Every listener that should receive presses (Android TODO #5): each tap is sent to all of them at once.
  // One URL per entry; change the IPs to those machines' addresses. The Settings screen edits this list.
  // (Older files with a single ListenerUrl string still work; saving from Settings converts them.)
  "ListenerUrls": [
    "http://192.168.4.28:5050/pecs",
    "http://192.168.4.22:5050/pecs"
  ],

  // Number of tile columns; rows are computed from the tile count.
  // 0 = automatic for the tile count (1-3 in one row, 4 = 2x2, 5-6 = 3x2, 7-8 = 4x2, 9 = 3x3, 10-12 = 4x3).
  "Columns": 0,

  // Repeat taps of the SAME tile within this many seconds are logged but not sent to the listener.
  // Ian still sees the normal feedback. 0 turns this off.
  "DebounceSeconds": 2,

  // Resolution of the 7" touch panel. With exactly 3 displays the app opens full screen on it
  // (or on the smallest non-primary display if none matches); otherwise it opens as a 1024x600 window.
  "TouchScreenSize": "1024x600",

  // The tiles normally come from the pictures in the Resources folder (TODO #10): every
  // .png/.jpg/.jpeg/.bmp whose name starts with a number becomes a tile, in number order, labeled with
  // the rest of the name ("01_Toilet.png" -> "Toilet", "05_Go_Outside.png" -> "Go Outside").
  // Remove the number ("Toilet.png") to hide a tile. Changes show up within a second or two.
  //
  // This list is used two ways:
  //   - Color override: a picture tile with the same Label uses this Color instead of the color
  //     taken from its picture.
  //   - Fallback: if Resources has no numbered pictures, these tiles are shown instead.
  //   Label: text on the tile and sent to the listener
  //   Color: named color (e.g. "LightBlue") or "#RRGGBB"; invalid values show LightGray
  //   Image: picture in the Resources folder for the fallback; empty or missing shows text only
  "Tiles": [
    { "Label": "Toilet", "Color": "LightBlue",   "Image": "01_Toilet.png" },
    { "Label": "Eat",  "Color": "LightGreen",  "Image": "02_Eat.png" },
    { "Label": "Walk",  "Color": "LightCyan",   "Image": "03_Walk.png" },
    { "Label": "Help",   "Color": "LightYellow", "Image": "04_Help.png" }
  ]
}
