{
  // URL of the PC running PECSListener. Change the IP to that machine's address.
  "ListenerUrl": "http://192.168.4.28:5050/pecs",

  // Number of tile columns; rows are computed from the tile count.
  "Columns": 2,

  // Repeat taps of the SAME tile within this many seconds are logged but not sent to the listener.
  // Ian still sees the normal feedback. 0 turns this off.
  "DebounceSeconds": 2,

  // Tiles shown on screen, in order (left to right, top to bottom).
  //   Label: text on the tile and sent to the listener
  //   Color: named color (e.g. "LightBlue") or "#RRGGBB"; invalid values show LightGray
  //   Image: optional filename in the Resources folder (e.g. "toilet.png"); empty or missing shows text only
  "Tiles": [
    { "Label": "Toilet", "Color": "LightBlue",   "Image": "toilet.png" },
    { "Label": "Eat",  "Color": "LightGreen",  "Image": "eat.png" },
    { "Label": "Walk",  "Color": "LightCyan",   "Image": "walk.png" },
    { "Label": "Help",   "Color": "LightYellow", "Image": "help.png" }
  ]
}
