{
  // PECS Listener (Android) alert options (TODO #3). Same keys as the Windows Listener's
  // appsettings.json where they make sense. Missing or invalid values use the defaults shown here.
  // Bundled into the APK: edit, rebuild and reinstall to change.

  // Speak each press with the phone's text-to-speech voice. {tile} is replaced with the tile name.
  "Speak": true,
  "SpeechTemplate": "Ian wants {tile}",

  // Milliseconds after the sound starts before the voice starts. 0 = together. Negative/invalid = 300.
  "SpeechDelayMs": 300,

  // Short vibration on each press.
  "Vibrate": true,

  // Banner and notification color per tile: "#RRGGBB". "Default" is for tiles not listed.
  "BannerColors": {
    "Toilet":  "#0050A0",
    "Eat":     "#00783C",
    "Walk":    "#A07800",
    "Help":    "#B42828",
    "Default": "#006400"
  },

  // Sound per tile: a short chime generated by the app, given as note frequencies in Hz, each
  // played for SoundNoteMs. (Generated, not the phone's ringtones: ringtone names differ between
  // phones and Android versions, so this sounds the same everywhere.) "Default" is for tiles not listed;
  // an empty list means no sound for that tile.
  "SoundNoteMs": 140,
  "Sounds": {
    "Toilet":  [ 523, 784 ],
    "Eat":     [ 784, 659, 523 ],
    "Walk":    [ 523, 659, 784, 1047 ],
    "Help":    [ 988, 740, 988, 740 ],
    "Default": [ 660, 880 ]
  }
}
